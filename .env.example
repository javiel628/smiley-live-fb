PORT=3000
NODE_ENV=production
# Obtain an API key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=replace_with_your_real_key
# Optional: keep the documented default unless using a compatible provider
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
# Server-side cache window in seconds (minimum 30)
CACHE_TTL_SECONDS=90
